{
  "pound": {
    "name": "Пих",
    "effect": "Цель физически толкают длинным хвостом, коленом и т.д."
  },
  "karateChop": {
    "name": "Удар Карате",
    "effect": "Цель атакована резким взмахом. У этого приёма шанс критического удара повышен на 1 стадию."
  },
  "doubleSlap": {
    "name": "Два Шлепка",
    "effect": "Цель получает множественные пощёчины туда-сюда, 2-5 раз подряд."
  },
  "cometPunch": {
    "name": "Удары-кометы",
    "effect": "Цель поражается шквалом ударов, которые бьют 2-5 раз подряд."
  },
  "megaPunch": {
    "name": "Мега Кулак",
    "effect": "Цель поражена ударом кулака, нанесённым с мышечной мощью."
  },
  "payDay": {
    "name": "По Счетам",
    "effect": "В цель метают монеты, нанося урон. При успешном попадании вы получите деньги после боя."
  },
  "firePunch": {
    "name": "Огнекулак",
    "effect": "Цель атакована огненным кулаком. Этот приём имеет 10% шанс обжечь цель."
  },
  "icePunch": {
    "name": "Ледокулак",
    "effect": "Цель атакована ледяным кулаком. Этот приём имеет 10% шанс заморозить цель."
  },
  "thunderPunch": {
    "name": "Кулак Грома",
    "effect": "Цель атакована электрическим кулаком. Приём имеет 10% шанс парализовать цель."
  },
  "scratch": {
    "name": "Царапание",
    "effect": "Твёрдые, заострённые, острые когти полосуют цель, нанося урон."
  },
  "viseGrip": {
    "name": "В Клещи",
    "effect": "Цель сжимают и стискивают с обеих сторон, нанося урон."
  },
  "guillotine": {
    "name": "Гильотина",
    "effect": "Жестокая разрывающая атака большими клешнями. Цель мгновенно падает без сознания при попадании, если только это не Босс-Покемон. Точность этого приёма фиксирована на 30%."
  },
  "razorWind": {
    "name": "Вихри-бритвы",
    "effect": "Пользователь атакует на следующий ход после использования этого приёма лезвиями ветра. Шанс критического удара этого приёма повышен на 1 ступень."
  },
  "swordsDance": {
    "name": "Танец Мечей",
    "effect": "Неистовый танец, поднимающая боевой дух. Резко повышает Атаку пользователя."
  },
  "cut": {
    "name": "Рез",
    "effect": "Цель поражают косой, когтем или чем-то подобным, нанося урон."
  },
  "gust": {
    "name": "Шквал",
    "effect": "Порыв ветра, поднятый крыльями, обрушивается на цель, нанося урон. Этот приём может поразить цель, находящуюся в воздухе после «Полёта», «Отскока» или «Сброса», с удвоенной силой."
  },
  "wingAttack": {
    "name": "Атака Крылом",
    "effect": "Цель поражают широко расправленными, крупными и внушительными крыльями, нанося урон."
  },
  "whirlwind": {
    "name": "Вихрь",
    "effect": "Пользователь действует последним и создаёт сильный ветер. Цель сдувает, а на её место вытаскивается другой Покемон. В дикой природе это завершает бой с одиночным Покемоном."
  },
  "fly": {
    "name": "Полёт",
    "effect": "Пользователь взмывает в небо на первом ходу, затем атакует на следующем."
  },
  "bind": {
    "name": "Сжатие",
    "effect": "Длинное тело, щупальца или что-то подобное используют, чтобы связать и сжать цель. В течение 4–5 ходов цель получает урон, равный ⅛ её максимального ОЖ, в конце каждого хода."
  },
  "slam": {
    "name": "Лязг",
    "effect": "Цель бьют длинным хвостом, лианами или чем-то подобным, нанося урон."
  },
  "vineWhip": {
    "name": "Плеть-Лиана",
    "effect": "Цель хлещут тонкими, плетевидными лианами, нанося урон."
  },
  "stomp": {
    "name": "Топот",
    "effect": "Пользователь атакует, топча цель большой ногой. Этот приём имеет 30% шанс заставить цель вздрогнуть. Если цель использовала «Минимизацию», сила приёма удваивается, и он гарантированно попадает."
  },
  "doubleKick": {
    "name": "Два Пинка",
    "effect": "Пользователь атакует, дважды подряд пиная цель двумя ногами."
  },
  "megaKick": {
    "name": "Мега Пинок",
    "effect": "Цель атакуют пинком, нанесённым с накачанной мышцами силой."
  },
  "jumpKick": {
    "name": "Прыг-Кик",
    "effect": "Пользователь высоко подпрыгивает, затем наносит удар ногой. Если приём промахивается или не срабатывает, пользователь получает урон, равный 1/2 его максимального ОЖ."
  },
  "rollingKick": {
    "name": "Кручёный Пинок",
    "effect": "Пользователь наносит быстрый удар ногой в прыжке с разворотом. Этот приём имеет 30% шанс заставить цель вздрогнуть."
  },
  "sandAttack": {
    "name": "Песчаная Атака",
    "effect": "В лицо цели бросают песок, понижая её точность."
  },
  "headbutt": {
    "name": "Таран",
    "effect": "Пользователь выставляет голову вперёд и атакует, бросаясь прямо на цель. Этот приём имеет 30% шанс заставить цель вздрогнуть."
  },
  "hornAttack": {
    "name": "Атака Рогом",
    "effect": "Цель бодают острым рогом, нанося урон."
  },
  "furyAttack": {
    "name": "Град Ударов",
    "effect": "Пользователь атакует, бодая цель рогом, клювом или чем-то подобным. Этот приём попадает 2–5 раз подряд."
  },
  "hornDrill": {
    "name": "Рог-дрель",
    "effect": "Пользователь пронзает цель рогом, вращающимся как дрель. Цель мгновенно падает без сознания при попадании, если только это не Босс-Покемон. Точность этого приёма фиксирована на 30%."
  },
  "tackle": {
    "name": "Толчок",
    "effect": "Физическая атака, при которой пользователь бросается и всем телом таранит цель."
  },
  "bodySlam": {
    "name": "Навал",
    "effect": "Пользователь атакует, падая на цель всем своим весом. Этот приём имеет 30% шанс парализовать цель. Если цель использовала «Минимизацию», сила приёма удваивается, и он гарантированно попадает."
  },
  "wrap": {
    "name": "Хват",
    "effect": "Длинное тело, лианы или что-то подобное используют, чтобы обвить и сжать цель. В течение 4–5 ходов цель получает урон, равный 1/8 её максимального ОЖ, в конце каждого хода."
  },
  "takeDown": {
    "name": "Налёт",
    "effect": "Безрассудная атака всем телом для тарана цели. Пользователь получает 1/4 нанесённого этим приёмом урона."
  },
  "thrash": {
    "name": "Буйство",
    "effect": "Пользователь буйствует и атакует 2–3 хода. Затем он приходит в замешательство."
  },
  "doubleEdge": {
    "name": "Обоюдный Риск",
    "effect": "Безрассудный, рискованный для жизни таран, при котором пользователь бросается на цель. Пользователь получает 1/3 нанесённого этим приёмом урона."
  },
  "tailWhip": {
    "name": "Виляние",
    "effect": "Пользователь мило виляет хвостом, отчего противостоящие Покемоны теряют бдительность. Это понижает их Защиту."
  },
  "poisonSting": {
    "name": "Жало с ядом",
    "effect": "Пользователь пронзает цель ядовитым жалом, нанося урон. Этот приём имеет 30% шанс отравить цель."
  },
